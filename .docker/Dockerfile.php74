FROM php:7.4-cli

# Debian 11 (bullseye) is EOL, so install from the archive mirror's main repo
# only (security/updates are gone). No `apt upgrade`: the archive is frozen.
RUN echo 'deb http://archive.debian.org/debian bullseye main' > /etc/apt/sources.list

# Install dependencies
RUN apt -o Acquire::Check-Valid-Until=false update && \
    apt install -y \
    git \
    curl \
    zip \
    unzip \
    libxml2-dev \
    libicu-dev

# Install additional PHP extensions
RUN docker-php-ext-install soap \
    && docker-php-ext-configure intl \
    && docker-php-ext-install intl

# Install Packages via PECL as not provided by PHP Source
RUN pecl install xdebug-3.1.5 \
	&& docker-php-ext-enable xdebug

# Clear cache
RUN apt clean && \
    rm -rf /var/lib/apt/lists/*

# Install composer (get latest v2, change to `--1` if you want to install the latest v1).
RUN curl -sS https://getcomposer.org/installer | php -- --2 --install-dir=/usr/local/bin --filename=composer

COPY . /usr/src/lib
WORKDIR /usr/src/lib

CMD [ "php"]
