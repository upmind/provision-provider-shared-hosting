{
    "name": "upmind/provision-provider-shared-hosting",
    "description": "This provision category contains the common functions used in provisioning flows for accounts/websites on various popular shared hosting platforms.",
    "type": "library",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Harry Lewis",
            "email": "harry@upmind.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Upmind\\ProvisionProviders\\SharedHosting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Upmind\\ProvisionProviders\\SharedHosting\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "ext-soap": "*",
        "giggsey/libphonenumber-for-php-lite": "^9",
        "illuminate/support": "^13.0",
        "plesk/api-php-lib": "^1.1",
        "upmind/20i-php-sdk": "^1.1",
        "upmind/enhance-sdk": "dev-feature/guzzle-8-support as 12.26.3",
        "upmind/provision-provider-base": "dev-feature/base-v5-support as 5.0.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Upmind\\ProvisionProviders\\SharedHosting\\LaravelServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
